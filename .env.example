# Ambiguous workspace REST API
AMBIGUOUS_API_URL=https://app.ambiguous.ai
AMBIGUOUS_API_KEY=replace_with_your_workspace_bearer_token

# OpenRouter task planner (hosted model; not a local runtime)
OPENROUTER_API_KEY=replace_with_your_openrouter_key
# Choose a model that supports structured outputs. This default can be changed.
OPENROUTER_MODEL=openai/gpt-4o-mini
